#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * SahilPHP CLI entry point.
 *
 * Commands boot the application through `bootstrap/app.php` and resolve
 * their services from the DI container, so CLI behavior and HTTP behavior
 * share one configuration and one set of bindings.
 *
 * Usage:
 *   bin/sahil                     → show help (exit 0)
 *   bin/sahil new [name]          → create a new application from this starter-kit
 *   bin/sahil about               → application facts
 *   bin/sahil config:show [ns]    → secret-safe configuration dump
 *   bin/sahil env:check           → documented environment variables
 *   bin/sahil key:generate        → write a new APP_KEY to .env
 *   bin/sahil storage:prepare     → create the writable storage directories
 *   bin/sahil start [--host=H] [--port=P] → run the development server
 *   bin/sahil ui:install [profile] → install Tailwind/Bootstrap/plain UI assets
 *   bin/sahil ui:dev              → Vite development server
 *   bin/sahil ui:build            → production asset build
 *   bin/sahil ui:status           → frontend readiness report
 *   bin/sahil ui:theme [profile]  → generate an optional theme from neutral tokens
 *   bin/sahil migrate [--force]   → apply pending migrations
 *   bin/sahil migrate:status      → applied / pending / missing migrations
 *   bin/sahil migrate:rollback [--steps=N] [--force]
 *   bin/sahil db:seed [--class=Name] [--force]
 *   bin/sahil queue:work [--once] [--max=N] [--queue=name]
 *   bin/sahil queue:failed|queue:flush [--queue=name]
 *   bin/sahil queue:retry <id>|--all [--queue=name]
 *   bin/sahil schedule:list [--at=...]
 *   bin/sahil schedule:run [--at=...] [--only=name]
 *   bin/sahil --version           → print versions
 *
 * The project root ships an equivalent entry point, so `php sahil <command>`
 * runs the same CLI without the `bin/` prefix.
 *
 * Destructive operations (rollback, seeding, any production schema change)
 * require deliberate operator intent: see `--force` in the help output and
 * the "Migrations & seeding" section of the README.
 */

// PHP 8.4 minimum version guard
if (PHP_VERSION_ID < 80400) {
    fwrite(STDERR, "SahilPHP requires PHP 8.4 or higher. You are running " . PHP_VERSION . ".\n");
    exit(1);
}

error_reporting(E_ALL);

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "This binary must be run from the command line.\n");
    exit(1);
}

$printHelp = static function (int $exitCode = 0): never {
    $help = <<<TEXT
        SahilPHP

        Usage: php sahil <command|option> [--force] [--steps=N] [--class=Name]
               [--queue=Name] [--once] [--max=N] [--all] [--at=...] [--only=Name]

        php bin/sahil <command> runs the same CLI from the bin directory.

        Commands:
          new               Create a new SahilPHP application from this starter-kit.
                            Interactive by default; non-interactive runs need
                            a project name and --ui=tailwind|bootstrap.
          about             Show application info (name, environment, debug, PHP).
          config:show       Inspect configuration; secrets are always [redacted].
                            Optional namespace: config:show app
          env:check         Validate documented environment variables
                            (names printed only; values are never shown).
          key:generate      Write a new APP_KEY to .env (--force replaces one).
          storage:prepare   Create the writable storage directories.
          start             Run the PHP development server (default
                            127.0.0.1:8000). Alias: serve. A busy port is
                            reported with the next free port to use.
          ui:install        Install a frontend asset profile (Tailwind v4,
                            Bootstrap 5, both, or plain CSS).
          ui:dev            Run the Vite development server.
          ui:build          Build production assets.
          ui:status         Report frontend prerequisites, sources and outputs.
          ui:theme          Generate optional framework theme files from neutral
                            tokens in theme/tokens.json.
          migrate           Apply every pending migration.
          migrate:status    List applied, pending and missing migrations.
          migrate:rollback  Reverse the newest migration batch.
          db:seed           Run registered seeders.
          queue:work        Process jobs from a queue. Runs until interrupted
                            unless --once or --max=N limits it.
          queue:failed      List failed jobs (id, queue, time, reason).
          queue:retry       Replay failed job(s): pass an id or --all.
          queue:flush       Delete failed job records for a queue.
          schedule:list     List scheduled tasks, their cadence and next run.
          schedule:run      Run the tasks due in the current minute (cron entry
                            point). Exits 1 when a task failed.

        Options:
          --force           Authorise a destructive operation without an
                            interactive prompt. REQUIRED in production for
                            migrate, migrate:rollback and db:seed.
                            (For ui:install this is an alias of --overwrite.)
          --path=DIR        new: exact destination directory (default: ./<name>);
                            ui:*/key:generate/storage:prepare: project root.
          --ui=NAME         new: tailwind | bootstrap (required when
                            non-interactive; --profile is an alias).
          --no-interaction  new: never prompt (short form: -n).
          --interactive     new: force prompts even when STDIN is not a TTY.
          --no-install      new/ui:install: generate files without installing
                            dependencies.
          --no-dev          new: Composer install without development packages.
          --steps=N         migrate:rollback: reverse the newest N batches.
          --class=Name      db:seed: run only the named seeder.
          --queue=Name      queue commands: queue to use (default: configured).
          --once            queue:work: process at most one job.
          --max=N           queue:work: process at most N jobs.
          --all             queue:retry: replay every failed job on the queue.
          --at=DATETIME     schedule commands: evaluate at this instant instead
                            of now ("Y-m-d H:i[:s]", in the schedule timezone).
          --only=Name       schedule:run: run only the named task.
          --host=HOST       start: interface to bind (default 127.0.0.1).
          --port=PORT       start: TCP port to bind (default 8000).
          --help            Show this help text.
          --version         Print framework and PHP versions.

        UI options (ui:install/dev/build/status/theme):
          --profile=NAME    tailwind | bootstrap | both | none
          --path=DIR        project root to operate on (default: this app)
          --source=FILE     ui:theme: neutral token file (default: theme/tokens.json)
          --dry-run         show the plan without writing or running commands
          --merge           preserve existing files; merge package.json
          --overwrite       replace managed files, keeping backups in
                            storage/framework/ui-backups/
          --no-install      scaffold files without running the package manager
          --clean           ui:build: remove public/build before building
          --host=HOST       ui:dev: bind Vite to HOST
          --port=PORT       ui:dev: use PORT
          --json            ui:status/ui:theme: machine-readable output

        Examples:
          bin/sahil new my-app
          bin/sahil new my-app --ui=tailwind
          bin/sahil new my-app --path=/tmp/my-app --ui=bootstrap --no-install
          bin/sahil key:generate
          bin/sahil storage:prepare
          php sahil start
          php sahil start --port=8088
          php sahil start --host=0.0.0.0 --port=8088
          bin/sahil ui:install tailwind
          bin/sahil ui:install bootstrap --no-install
          bin/sahil ui:install both --merge
          bin/sahil ui:theme
          bin/sahil ui:theme --source=theme/brand.json
          bin/sahil ui:build --clean
          bin/sahil ui:status --json

        Development server:
          php sahil start                             127.0.0.1:8000
          php bin/sahil start                         same CLI, bin path
          php sahil start --port=8088                 any free port
          php sahil start --host=0.0.0.0 --port=8088  bind all interfaces
          composer start -- --port=8088               Composer needs the -- separator

          When the port is already taken the command reports it and prints the
          next free port instead of failing with Composer's raw script error.

        Status endpoints:
          GET /health      JSON health payload.
        TEXT;

    fwrite($exitCode === 0 ? STDOUT : STDERR, $help . PHP_EOL);
    exit($exitCode);
};

$args = array_slice($argv, 1);
$flag = $args[0] ?? '--help';

// UI commands are build tools: they need the project directory but not a
// booted application (no config, database or service providers). Handling
// them first keeps `ui:*` usable in a fresh or partially configured project.
require_once __DIR__ . '/../vendor/autoload.php';

if ($flag === 'new') {
    $workingDirectory = getcwd();

    exit((new \Sahil\Installer\ProjectConsole())->run(
        array_slice($args, 1),
        dirname(__DIR__),
        $workingDirectory === false ? dirname(__DIR__) : $workingDirectory,
    ));
}

if (in_array($flag, \Sahil\Ui\UiConsole::COMMANDS, true)) {
    exit((new \Sahil\Ui\UiConsole())->run($flag, array_slice($args, 1), dirname(__DIR__)));
}

// ---------------------------------------------------------------------------
// Project setup commands. Like the UI commands they only touch the project
// directory, so they work before the application boots — which is exactly when
// `composer create-project` runs them.
// ---------------------------------------------------------------------------
if (in_array($flag, ['key:generate', 'storage:prepare'], true)) {
    $root = dirname(__DIR__);
    $force = false;

    foreach (array_slice($args, 1) as $option) {
        if ($option === '--force') {
            $force = true;
        } elseif (str_starts_with($option, '--path=')) {
            $root = rtrim(substr($option, 7), '/');
        }
    }

    if ($root === '' || !is_dir($root)) {
        fwrite(STDERR, sprintf("%s: project directory [%s] does not exist.\n", $flag, $root));
        exit(1);
    }

    if ($flag === 'key:generate') {
        $file = new \App\Support\EnvironmentFile($root . '/.env');

        if (!$file->exists() && is_file($root . '/.env.example')) {
            if (!@copy($root . '/.env.example', $root . '/.env')) {
                fwrite(STDERR, "key:generate: unable to create .env from .env.example.\n");
                exit(1);
            }

            fwrite(STDOUT, "Created .env from .env.example.\n");
        }

        $existing = $file->get('APP_KEY');

        if ($existing !== null && trim($existing) !== '' && !$force) {
            fwrite(STDERR, "key:generate: APP_KEY is already set; pass --force to replace it.\n");
            exit(1);
        }

        try {
            $key = \Sahil\Encryption\KeyGenerator::generate();
            $written = $file->set('APP_KEY', $key);
        } catch (Throwable $failure) {
            fwrite(STDERR, sprintf("key:generate: %s\n", $failure->getMessage()));
            exit(1);
        }

        fwrite(STDOUT, sprintf("APP_KEY written to %s\n", $written));
        fwrite(STDOUT, "Keep it secret: it protects encrypted and signed values.\n");
        exit(0);
    }

    $directories = [
        'storage/framework/views',
        'storage/framework/sessions',
        'storage/framework/cache',
        'storage/logs',
        'storage/uploads',
    ];
    $created = 0;

    foreach ($directories as $directory) {
        $path = $root . '/' . $directory;

        if (is_dir($path)) {
            continue;
        }

        if (!@mkdir($path, 0o775, true) && !is_dir($path)) {
            fwrite(STDERR, sprintf("storage:prepare: unable to create %s\n", $directory));
            exit(1);
        }

        @chmod($path, 0o775);
        fwrite(STDOUT, sprintf("created %s/\n", $directory));
        $created++;
    }

    fwrite(STDOUT, $created === 0
        ? "storage: ready.\n"
        : sprintf("%d director%s created; storage ready.\n", $created, $created === 1 ? 'y' : 'ies'));
    exit(0);
}

// ---------------------------------------------------------------------------
// Development server. It needs only the project directory, so it runs before
// the application boots — a missing APP_KEY or database never blocks it — and
// PHP's own server output and exit code are passed straight through.
// ---------------------------------------------------------------------------
if ($flag === 'start' || $flag === 'serve') {
    $startArguments = array_slice($args, 1);

    if (in_array('--help', $startArguments, true) || in_array('-h', $startArguments, true)) {
        $printHelp();
    }

    $host = '127.0.0.1';
    $portValue = null;

    for ($index = 0; $index < count($startArguments); $index++) {
        $option = (string) $startArguments[$index];

        if ($option === '--host' || $option === '--port') {
            $value = (string) ($startArguments[$index + 1] ?? '');
            $index++;

            if ($option === '--host') {
                $host = $value;
            } else {
                $portValue = $value;
            }

            continue;
        }

        if (str_starts_with($option, '--host=')) {
            $host = substr($option, 7);

            continue;
        }

        if (str_starts_with($option, '--port=')) {
            $portValue = substr($option, 7);

            continue;
        }

        fwrite(STDERR, sprintf("start: unknown option [%s].\n", $option));
        fwrite(STDERR, "usage: php sahil start [--host=127.0.0.1] [--port=8000]\n");
        exit(1);
    }

    $portText = $portValue === null ? '8000' : trim($portValue);

    if (preg_match('/^\d{1,5}$/', $portText) !== 1 || (int) $portText < 1 || (int) $portText > 65535) {
        fwrite(STDERR, sprintf(
            "start: invalid port [%s]; use a number between 1 and 65535.\n",
            $portValue === null ? '' : $portValue
        ));
        exit(1);
    }

    $port = (int) $portText;
    $host = trim($host);

    if ($host === '' || preg_match('/^[A-Za-z0-9._:\[\]-]+$/', $host) !== 1) {
        fwrite(STDERR, sprintf(
            "start: invalid host [%s]; use an address such as 127.0.0.1, localhost or 0.0.0.0.\n",
            $host
        ));
        exit(1);
    }

    // IPv6 literals are bracketed inside a socket address.
    $bindHost = str_contains($host, ':') && !str_starts_with($host, '[') ? '[' . $host . ']' : $host;
    $bindAddress = $bindHost . ':' . $port;

    $socketError = 0;
    $socketMessage = '';
    $probe = @stream_socket_server('tcp://' . $bindAddress, $socketError, $socketMessage);

    if ($probe === false) {
        $suggestion = null;

        for ($candidate = $port + 1; $candidate <= min(65535, $port + 20); $candidate++) {
            $free = @stream_socket_server('tcp://' . $bindHost . ':' . $candidate);

            if ($free !== false) {
                fclose($free);
                $suggestion = $candidate;

                break;
            }
        }

        fwrite(STDERR, sprintf(
            "start: %s:%d is already in use or unavailable%s.\n",
            $host,
            $port,
            $socketMessage === '' ? '' : ' (' . $socketMessage . ')'
        ));
        fwrite(STDERR, $suggestion === null
            ? "  try: php sahil start --port=<another-port>\n"
            : sprintf("  try: php sahil start --port=%d\n", $suggestion));
        fwrite(STDERR, "  usage: php sahil start [--host=127.0.0.1] [--port=8000]\n");
        exit(1);
    }

    fclose($probe);

    $root = dirname(__DIR__);

    fwrite(STDOUT, "SahilPHP development server\n");
    fwrite(STDOUT, sprintf("  http://%s:%d\n", $bindHost, $port));
    fwrite(STDOUT, sprintf("  document root: %s/public\n", $root));
    fwrite(STDOUT, "  press Ctrl-C to stop\n\n");

    // The banner must reach a redirected log before the process is replaced.
    fflush(STDOUT);

    $serverArguments = ['-S', $bindAddress, '-t', $root . '/public', $root . '/public/index.php'];

    // Replace this process with the server when pcntl is available: Ctrl-C,
    // exit codes and "stop the process" then apply to the server itself rather
    // than to a wrapper that could leave it running.
    if (function_exists('pcntl_exec')) {
        pcntl_exec(PHP_BINARY, $serverArguments);
    }

    $server = proc_open(
        [PHP_BINARY, ...$serverArguments],
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes,
        $root
    );

    if (!is_resource($server)) {
        fwrite(STDERR, "start: unable to launch the PHP development server.\n");
        exit(1);
    }

    exit(proc_close($server));
}

try {
    require_once __DIR__ . '/../bootstrap/app.php';

    // Boot failures propagate out of the require and are caught here: CLI
    // output stays a single clear error line without stack traces.
    $application = sahil_bootstrap();
} catch (Throwable $bootstrapError) {
    fwrite(STDERR, sprintf("Boot error: %s\n", $bootstrapError->getMessage()));
    exit(1);
}

$argument = $args[1] ?? null;

/** @return array{force: bool, steps: int, class: ?string, queue: ?string, once: bool, max: ?int, all: bool, at: ?string, only: ?string} */
$parseOptions = static function (array $args): array {
    $force = false;
    $steps = 1;
    $class = null;
    $queue = null;
    $once = false;
    $max = null;
    $all = false;
    $at = null;
    $only = null;

    foreach ($args as $arg) {
        if ($arg === '--force') {
            $force = true;
        } elseif ($arg === '--once') {
            $once = true;
        } elseif ($arg === '--all') {
            $all = true;
        } elseif (str_starts_with($arg, '--steps=')) {
            $steps = max(1, (int) substr($arg, 8));
        } elseif (str_starts_with($arg, '--class=')) {
            $class = substr($arg, 8);
        } elseif (str_starts_with($arg, '--queue=')) {
            $queue = substr($arg, 8);
        } elseif (str_starts_with($arg, '--max=')) {
            $max = max(1, (int) substr($arg, 6));
        } elseif (str_starts_with($arg, '--at=')) {
            $at = substr($arg, 5);
        } elseif (str_starts_with($arg, '--only=')) {
            $only = substr($arg, 7);
        }
    }

    return [
        'force' => $force,
        'steps' => $steps,
        'class' => $class,
        'queue' => $queue,
        'once' => $once,
        'max' => $max,
        'all' => $all,
        'at' => $at,
        'only' => $only,
    ];
};

if ($flag === '--help' || $flag === '-h') {
    $printHelp();
}

if ($flag === '--version' || $flag === '-V') {
    $name = (string) $application->config()->get('app.name', 'SahilPHP');
    fwrite(STDOUT, sprintf("%s, PHP %s\n", $name, PHP_VERSION));
    exit(0);
}

// Secret-safety: every command below prints only inspected, redacted data
// produced through Sahil\Support\Inspection\Inspector.
if ($flag === 'about' || $flag === '--about') {
    foreach (\Sahil\Support\Inspection\Inspector::about($application) as $label => $value) {
        fwrite(STDOUT, sprintf("%-13s %s\n", $label . ':', $value));
    }
    exit(0);
}

if ($flag === 'config:show') {
    try {
        $flat = \Sahil\Support\Inspection\Inspector::configSafe($application, $argument);
    } catch (\InvalidArgumentException $namespaceError) {
        fwrite(STDERR, sprintf("config:show: %s\n", $namespaceError->getMessage()));
        exit(1);
    }

    foreach ($flat as $key => $value) {
        $display = match (true) {
            is_bool($value) => $value ? 'true' : 'false',
            $value === null => '(null)',
            default => (string) $value,
        };

        fwrite(STDOUT, sprintf("%s = %s\n", $key, $display));
    }
    exit(0);
}

if ($flag === 'env:check') {
    $check = \Sahil\Support\Inspection\Inspector::environmentCheck($application);

    foreach ($check['report'] as $line) {
        fwrite($check['exit'] === 0 ? STDOUT : STDERR, $line . PHP_EOL);
    }

    exit($check['exit']);
}

// ---------------------------------------------------------------------------
// Migration and seeding commands. Database problems, unreadable migration
// files and refused destructive operations all report one clear line; the
// database is never left in an ambiguous state silently.
// ---------------------------------------------------------------------------
if (in_array($flag, ['migrate', 'migrate:status', 'migrate:rollback', 'db:seed'], true)) {
    $options = $parseOptions($args);

    try {
        if ($flag === 'migrate:status') {
            /** @var \Sahil\Migrations\Migrator $migrator */
            $migrator = $application->container()->make(\Sahil\Migrations\Migrator::class);
            $status = $migrator->status();

            /** @var \Sahil\Migrations\MigrationRepository $repository */
            $repository = $application->container()->make(\Sahil\Migrations\MigrationRepository::class);
            /** @var \Sahil\Database\Schema\Schema $schema */
            $schema = $application->container()->make(\Sahil\Database\Schema\Schema::class);

            fwrite(STDOUT, sprintf(
                "migrations ledger: %s (%s)\n",
                $repository->table(),
                $schema->dialect()
            ));

            foreach ($status['applied'] as $row) {
                fwrite(STDOUT, sprintf(
                    "  applied  %-52s batch %-3d %s\n",
                    $row['name'],
                    $row['batch'],
                    $row['applied_at'] ?? '(no timestamp)'
                ));
            }

            foreach ($status['pending'] as $name) {
                fwrite(STDOUT, sprintf("  pending  %s\n", $name));
            }

            foreach ($status['missing'] as $name) {
                fwrite(STDOUT, sprintf("  missing  %s (recorded but no file on disk)\n", $name));
            }

            if ($status['applied'] === [] && $status['pending'] === [] && $status['missing'] === []) {
                fwrite(STDOUT, "  no migrations discovered\n");
            }

            exit(0);
        }

        if ($flag === 'db:seed') {
            /** @var \Sahil\Migrations\SeederRunner $runner */
            $runner = $application->container()->make(\Sahil\Migrations\SeederRunner::class);

            /** @var \Sahil\Migrations\MutationGuard $guard */
            $guard = $application->container()->make(\Sahil\Migrations\MutationGuard::class);

            $guard->authorise(
                'db:seed',
                $options['force'],
                $options['class'] === null
                    ? 'Run every registered seeder?'
                    : sprintf('Run seeder [%s]?', $options['class'])
            );

            $seeder = $options['class'];

            $report = $seeder === null
                ? $runner->runAll()
                : new \Sahil\Migrations\MigrationReport(
                    command: 'db:seed',
                    applied: array_values(array_filter([$runner->runOne($seeder)])),
                    notes: ['single seeder requested'],
                );
        } elseif ($flag === 'migrate') {
            /** @var \Sahil\Migrations\Migrator $migrator */
            $migrator = $application->container()->make(\Sahil\Migrations\Migrator::class);
            $report = $migrator->migrate($options['force']);
        } else {
            /** @var \Sahil\Migrations\Migrator $migrator */
            $migrator = $application->container()->make(\Sahil\Migrations\Migrator::class);
            $report = $migrator->rollback($options['force'], $options['steps']);
        }
    } catch (\Sahil\Database\ConnectionException $connectionError) {
        fwrite(STDERR, sprintf("%s: %s\n", $flag, $connectionError->getMessage()));
        exit(1);
    } catch (\Sahil\Migrations\DestructiveOperationException $refusal) {
        fwrite(STDERR, sprintf("%s: %s\n", $flag, $refusal->getMessage()));
        exit(1);
    } catch (\Sahil\Migrations\MigrationException $migrationError) {
        fwrite(STDERR, sprintf("%s: %s\n", $flag, $migrationError->getMessage()));
        exit(1);
    } catch (Throwable $unexpected) {
        // One clear line instead of a stack trace; the class name is added
        // only when diagnostics are explicitly enabled.
        $debug = $application->config()->get('app.debug') === true;

        fwrite(STDERR, sprintf(
            "%s: %s%s\n",
            $flag,
            $unexpected->getMessage(),
            $debug ? ' ('.$unexpected::class.')' : ''
        ));
        exit(1);
    }

    foreach ($report->lines() as $line) {
        fwrite(STDOUT, $line.PHP_EOL);
    }

    exit(0);
}

// ---------------------------------------------------------------------------
// Queue commands. `queue:work` runs until interrupted; failed jobs are
// inspected and replayed through the same dispatcher that queued them, so a
// retried job is an ordinary job again.
// ---------------------------------------------------------------------------
if (in_array($flag, ['queue:work', 'queue:failed', 'queue:retry', 'queue:flush'], true)) {
    $options = $parseOptions($args);
    $container = $application->container();
    $configuration = $application->config();
    $queueName = $options['queue'] ?? (string) $configuration->get('queue.work.queue', 'default');

    try {
        if ($flag === 'queue:work') {
            $worker = new \Sahil\Queue\Worker(
                $container->make(\Sahil\Contracts\Queue\QueueContract::class),
                $container->make(\Sahil\Contracts\Queue\FailedJobRepositoryContract::class),
                $queueName,
                (int) $configuration->get('queue.retry.max_attempts', 3),
                (int) $configuration->get('queue.retry.delay', 0),
                (int) $configuration->get('queue.work.sleep', 1),
            );

            $limit = $options['max'];

            fwrite(STDOUT, sprintf(
                "queue:work on [%s]%s\n",
                $queueName,
                $options['once']
                    ? ' — one job or nothing'
                    : ($limit === null ? ' — interrupt to stop' : sprintf(' — at most %d job(s)', $limit))
            ));

            // --once never waits for work: it answers "was a job processed?"
            // immediately, which is what cron and health checks need.
            $processed = $options['once']
                ? ($worker->runNextJob() ? 1 : 0)
                : $worker->work($limit);

            fwrite(STDOUT, sprintf("processed %d job(s)\n", $processed));
            exit(0);
        }

        // Validate queue:retry arguments BEFORE touching the database, so a
        // usage error is never reported as a connection error.
        $target = null;

        if ($flag === 'queue:retry') {
            foreach (array_slice($args, 1) as $candidate) {
                if (!str_starts_with((string) $candidate, '--')) {
                    $target = $candidate;
                }
            }

            if (!$options['all'] && $target === null) {
                fwrite(STDERR, "queue:retry: pass a job id or --all.\n");
                exit(1);
            }
        }

        /** @var \Sahil\Contracts\Queue\FailedJobRepositoryContract $failures */
        $failures = $container->make(\Sahil\Contracts\Queue\FailedJobRepositoryContract::class);

        if ($flag === 'queue:failed') {
            $jobs = $failures->all($queueName);

            if ($jobs === []) {
                fwrite(STDOUT, sprintf("no failed jobs on [%s]\n", $queueName));
                exit(0);
            }

            foreach ($jobs as $job) {
                fwrite(STDOUT, sprintf(
                    "  %s  %-20s %s  %s\n",
                    $job->id,
                    $job->queue,
                    $job->failedAt,
                    $job->exception
                ));
            }

            exit(0);
        }

        if ($flag === 'queue:flush') {
            $jobs = $failures->all($queueName);

            foreach ($jobs as $job) {
                $failures->delete($job->id);
            }

            fwrite(STDOUT, sprintf("flushed %d failed job(s) on [%s]\n", count($jobs), $queueName));
            exit(0);
        }

        // queue:retry
        if ($options['all']) {
            $jobs = $failures->all($queueName);
        } elseif ($target !== null) {
            $job = $failures->find($target);

            if ($job === null) {
                fwrite(STDERR, sprintf("queue:retry: no failed job [%s].\n", $target));
                exit(1);
            }

            $jobs = [$job];
        } else {
            // Unreachable: validated above.
            exit(1);
        }

        /** @var \Sahil\Contracts\Queue\DispatcherContract $dispatcher */
        $dispatcher = $container->make(\Sahil\Contracts\Queue\DispatcherContract::class);

        foreach ($jobs as $job) {
            $dispatcher->pushRaw($job->queue, $job->payload);
            $failures->delete($job->id);

            fwrite(STDOUT, sprintf("retried %s on [%s]\n", $job->id, $job->queue));
        }

        exit(0);
    } catch (\Sahil\Database\ConnectionException $connectionError) {
        fwrite(STDERR, sprintf("%s: %s\n", $flag, $connectionError->getMessage()));
        exit(1);
    } catch (Throwable $unexpected) {
        $debug = $application->config()->get('app.debug') === true;

        fwrite(STDERR, sprintf(
            "%s: %s%s\n",
            $flag,
            $unexpected->getMessage(),
            $debug ? ' ('.$unexpected::class.')' : ''
        ));
        exit(1);
    }
}

// ---------------------------------------------------------------------------
// Scheduler commands. `schedule:run` is the single cron/systemd entry point:
// it evaluates the current minute, runs every due task, prints a result line
// per task, and exits 1 when anything failed.
// ---------------------------------------------------------------------------
if (in_array($flag, ['schedule:list', 'schedule:run'], true)) {
    $options = $parseOptions($args);
    $container = $application->container();
    $configuration = $application->config();
    $timezone = new DateTimeZone((string) $configuration->get('schedule.timezone', 'UTC'));

    $at = null;

    if ($options['at'] !== null) {
        try {
            $at = new DateTimeImmutable($options['at'], $timezone);
        } catch (Exception) {
            fwrite(STDERR, sprintf(
                "%s: invalid --at value [%s]; use \"Y-m-d H:i[:s]\" in %s.\n",
                $flag,
                $options['at'],
                $timezone->getName()
            ));
            exit(1);
        }
    }

    try {
        /** @var \Sahil\Scheduler\Schedule $schedule */
        $schedule = $container->make(\Sahil\Scheduler\Schedule::class);
        $now = $at ?? $container->make(\Sahil\Contracts\Scheduler\ClockContract::class)->now();

        if ($flag === 'schedule:list') {
            fwrite(STDOUT, sprintf(
                "schedule (%s, %d task(s))\n",
                $schedule->timezone(),
                count($schedule->tasks())
            ));

            if ($schedule->isEmpty()) {
                fwrite(STDOUT, "  no scheduled tasks (define them in routes/schedule.php)\n");
                exit(0);
            }

            foreach ($schedule->tasks() as $task) {
                fwrite(STDOUT, sprintf(
                    "  %-28s %-14s %-20s overlap=%-3s timeout=%-4s next=%s\n",
                    $task->name(),
                    $task->expression(),
                    $task->timezone(),
                    $task->preventsOverlap() ? 'yes' : 'no',
                    $task->timeout() > 0 ? $task->timeout().'s' : '-',
                    $task->nextRunAfter($now)->format('Y-m-d H:i T')
                ));
            }

            exit(0);
        }

        /** @var \Sahil\Scheduler\ScheduleRunner $runner */
        $runner = $container->make(\Sahil\Scheduler\ScheduleRunner::class);
        $report = $runner->runAt($now, $options['only']);

        fwrite(STDOUT, sprintf(
            "schedule:run at %s (%s)\n",
            $report->at->setTimezone($timezone)->format('Y-m-d H:i:s T'),
            $timezone->getName()
        ));

        if ($report->isEmpty()) {
            fwrite(STDOUT, "  no tasks due\n");
            exit(0);
        }

        foreach ($report->results() as $result) {
            $detail = $result->message !== '' ? ' — '.$result->message : '';
            $duration = $result->seconds > 0 ? sprintf(' (%.3fs)', $result->seconds) : '';

            fwrite(STDOUT, sprintf(
                "  %-8s %s%s%s\n",
                $result->status,
                $result->task,
                $detail,
                $duration
            ));
        }

        fwrite(STDOUT, sprintf(
            "%d ran, %d skipped, %d failed\n",
            $report->ran(),
            $report->skipped(),
            $report->failedCount()
        ));

        exit($report->failed() ? 1 : 0);
    } catch (\Sahil\Scheduler\SchedulerException $schedulerError) {
        fwrite(STDERR, sprintf("%s: %s\n", $flag, $schedulerError->getMessage()));
        exit(1);
    } catch (\Sahil\Database\ConnectionException $connectionError) {
        fwrite(STDERR, sprintf("%s: %s\n", $flag, $connectionError->getMessage()));
        exit(1);
    } catch (Throwable $unexpected) {
        $debug = $application->config()->get('app.debug') === true;

        fwrite(STDERR, sprintf(
            "%s: %s%s\n",
            $flag,
            $unexpected->getMessage(),
            $debug ? ' ('.$unexpected::class.')' : ''
        ));
        exit(1);
    }
}

fwrite(STDERR, sprintf("Unknown option: %s\n", $flag));
$printHelp(1);
