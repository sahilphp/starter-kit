{
    "name": "sahilphp/starter-kit",
    "description": "A starter application for building projects with the SahilPHP framework.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Idrisa24",
            "email": "idrisajohn19@gmail.com"
        }
    ],
    "homepage": "https://github.com/sahilphp/starter-kit",
    "support": {
        "issues": "https://github.com/sahilphp/starter-kit/issues",
        "source": "https://github.com/sahilphp/starter-kit"
    },
    "keywords": [
        "sahilphp",
        "starter-kit",
        "application",
        "framework"
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../firefiber",
            "options": {
                "symlink": true,
                "versions": {
                    "sahilphp/firefiber": "1.0.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "sahilphp/firefiber": "^1.0",
        "sahilphp/framework": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "@php sahil start",
        "test": "phpunit --configuration phpunit.xml --colors=always",
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php bin/sahil key:generate",
            "@php bin/sahil storage:prepare"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.4.0"
        }
    }
}
